# --- Firebase web config ---
# Copy this file to `.env` and fill in your values from the Firebase console:
#   Project settings -> Your apps -> Web app -> SDK setup and configuration
# Every variable MUST start with EXPO_PUBLIC_ so Expo injects it into the app.

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# --- AI (optional) ---
# If you paste an OpenAI key here, Battle Buddy will use it for real replies.
# If you leave it blank, Battle Buddy uses a built-in offline responder so chat still works.
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
